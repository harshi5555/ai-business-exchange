# ─────────────────────────────────────────────────────────────────────────────
# Single-host Fly.io deployment — one app runs ALL services.
# Used by:  bash infra/fly/single/setup-single.sh
#           bash infra/fly/single/deploy-single.sh
#
# Copy this file:  cp infra/.env.fly.single.example infra/.env.fly.single
# Never commit infra/.env.fly.single — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Fly.io auth & config ──────────────────────────────────────────────────────
FLY_API_TOKEN=             # flyctl auth token  (flyctl auth token)
FLY_ORG=personal           # your Fly org slug  (flyctl orgs list)
FLY_REGION=lhr             # lhr=London  iad=US-East  sin=Singapore  nrt=Tokyo

# Single app name — must be globally unique on Fly.io
# All services (gateway, portal, auth, etc.) run inside this one app.
APP_NAME=bx-app
# PG_NAME defaults to ${APP_NAME}-db — override only if needed
# PG_NAME=bx-app-db

# ── Application secrets ───────────────────────────────────────────────────────
JWT_SECRET=                # openssl rand -hex 32
WEBHOOK_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=            # openssl rand -hex 32

# Provisioned automatically by setup-single.sh — leave blank on first run
DATABASE_URL=

# ── AI provider ───────────────────────────────────────────────────────────────
# Set to one of: azure | openai | openai-compatible
AI_PROVIDER=azure

# Azure OpenAI (AI_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Plain OpenAI (AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible — Groq, Ollama, Together AI, etc. (AI_PROVIDER=openai-compatible)
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=llama-3.1-8b-instant
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

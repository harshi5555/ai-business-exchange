# ─────────────────────────────────────────────────────────────────────────────
# Multi-app Fly.io deployment — each service runs as its own Fly app.
# Apps created: bx-gateway, bx-auth-service, bx-partner-service,
#               bx-subscription-service, bx-integration-service,
#               bx-mapping-engine, bx-agent-orchestrator,
#               bx-billing-service, bx-partner-portal, bx-postgres
# Used by:  bash infra/fly/multi/setup.sh
#           bash infra/fly/multi/deploy.sh
#
# Copy this file:  cp infra/.env.fly.multi.example infra/.env.fly.multi
# Never commit infra/.env.fly.multi — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Fly.io auth & config ──────────────────────────────────────────────────────
FLY_API_TOKEN=             # flyctl auth token  (flyctl auth token)
FLY_ORG=personal           # your Fly org slug  (flyctl orgs list)
FLY_REGION=lhr             # lhr=London  iad=US-East  sin=Singapore  nrt=Tokyo

# ── Application secrets (shared across all backend services) ──────────────────
JWT_SECRET=                # openssl rand -hex 32
WEBHOOK_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=            # openssl rand -hex 32

# Provisioned automatically by setup.sh — leave blank on first run
DATABASE_URL=

# ── Partner portal build arg ──────────────────────────────────────────────────
# Public URL of the gateway app (used as NEXT_PUBLIC_API_URL at build time)
GATEWAY_URL=https://bx-gateway.fly.dev

# ── AI provider ───────────────────────────────────────────────────────────────
# Set to one of: azure | openai | openai-compatible
AI_PROVIDER=azure

# Azure OpenAI (AI_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Plain OpenAI (AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible — Groq, Ollama, Together AI, etc. (AI_PROVIDER=openai-compatible)
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=llama-3.1-8b-instant
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
